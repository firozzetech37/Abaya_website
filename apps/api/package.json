{
  "name": "@abaya/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS modular monolith: the only service that touches the database",
  "scripts": {
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "jest --config test/jest-e2e.config.cjs --runInBand"
  },
  "dependencies": {
    "@abaya/contracts": "workspace:*",
    "@abaya/db": "workspace:*",
    "@clerk/backend": "^3.20.1",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "helmet": "^8.0.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^4.6.1",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@abaya/config": "workspace:*",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "webpack": "^5.97.0",
    "webpack-node-externals": "^3.0.0"
  }
