# Copy this file to .env and fill in real values. Never commit .env.
# Use a separate Supabase project for development and for production.

# ---------- Supabase: database (Prisma) ----------
# Supabase dashboard → Connect → ORMs → Prisma
# Pooled connection (transaction mode, port 6543) — used by the running API
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session connection (port 5432) — used only by `prisma migrate`
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------- Supabase: storage (the database URLs are above) ----------
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# SERVER ONLY — never expose to web or mobile code
SUPABASE_SERVICE_ROLE_KEY="..."
SUPABASE_STORAGE_BUCKET_DESIGNS="designs"
SUPABASE_STORAGE_BUCKET_PRIVATE="private"

# ---------- API ----------
API_PORT=4000
API_PUBLIC_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
# Customer website, used for links in emails
WEB_PUBLIC_URL="http://localhost:3000"
# Staff must use two-factor login (Supabase MFA). Defaults to true in production, false otherwise.
STAFF_MFA_REQUIRED=""

# ---------- Login: Clerk (dashboard.clerk.com → your app → API keys) ----------
# SERVER ONLY (API + Next.js middleware). Never in mobile code.
CLERK_SECRET_KEY="sk_test_..."
# Optional: verify tokens without a network call (API keys → "JWT public key" → PEM)
CLERK_JWT_KEY=""
# Optional: website origins allowed to send tokens; defaults to CORS_ORIGINS
CLERK_AUTHORIZED_PARTIES=""

# ---------- Client apps (public values only) ----------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
EXPO_PUBLIC_API_URL="http://192.168.1.10:4000"   # your laptop's LAN IP so the phone can reach it
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."   # same publishable key

# ---------- Payments: Razorpay (TEST keys until launch) ----------
# razorpay | fake. "fake" = development-only "Simulate payment" button, no Razorpay needed
# (the API refuses to start with it in production). The Razorpay keys are then optional.
PAYMENT_PROVIDER="razorpay"
RAZORPAY_KEY_ID="rzp_test_..."

# Display currency: prices are charged in INR; the website can show AED converted at a live daily rate.
# FX_RATE_URL="https://open.er-api.com/v6/latest/INR"   # free feed, no key (default)
# FX_AED_PER_INR=0.038                                   # fallback when the feed is unreachable
# FX_SAR_PER_INR=0.039                                   # Saudi riyal fallback when the feed is unreachable
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# ---------- Jobs / cache (Phase 2+) ----------
UPSTASH_REDIS_URL=""

# ---------- Messaging (Phase 2+) ----------
# WhatsApp order updates: none | interakt | gupshup  (templates: docs/whatsapp-templates.md)
WHATSAPP_PROVIDER="none"
WHATSAPP_PROVIDER_API_KEY=""
GUPSHUP_SOURCE_NUMBER=""                # gupshup only, e.g. 919812345678
GUPSHUP_APP_NAME=""                     # gupshup only
WHATSAPP_TEMPLATE_IDS=""                # gupshup only, JSON {"order_confirmed":"<id>",...}
# Expo push for the customer app (token optional)
PUSH_ENABLED="true"
EXPO_ACCESS_TOKEN=""
RESEND_API_KEY=""                      # order emails are skipped when empty
EMAIL_FROM="Abaya <orders@example.com>"

# ---------- Shipping (Phase 2+) ----------
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# ---------- Pinterest (Designer Studio → Inspiration, docs/apps/studio.md) ----------
# Pasted pin links work without any key (Pinterest's public oEmbed). To browse the company's
# own boards, add an access token for the company Pinterest account (scopes: boards:read, pins:read).
# Pin images are only shown from Pinterest; they are never downloaded, stored or sent to the AI.
PINTEREST_ACCESS_TOKEN=""
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
PINTEREST_REDIRECT_URI="http://localhost:4000/integrations/pinterest/callback"

# ---------- Studio AI Catalog: FASHN (docs/apps/studio.md "AI Catalog") ----------
# Key from app.fashn.ai → Developer API. Without it the AI Catalog runs in test mode
# (placeholder images, no credits). The key stays on the API server only.
FASHN_API_KEY=""
# FASHN credits one designer may use per day (4K quality = 5 credits per image).
FASHN_DAILY_CREDIT_LIMIT="40"
# Website "Preview my design" and "Try it on" (same FASHN key). Per customer per day, and
# the credits all customers together may use per day.
CUSTOMER_PREVIEW_DAILY_LIMIT="20"
CUSTOMER_TRYON_DAILY_LIMIT="20"
CUSTOMER_AI_DAILY_CREDIT_LIMIT="200"

# ---------- Designer Studio AI Design (docs/apps/studio.md) ----------
# Without GEMINI_API_KEY the Studio runs in test mode (placeholder images). Add the key to
# switch on Nano Banana. The key stays on the API server only.
GEMINI_API_KEY=""
# Gemini model that reads photos and answers in text (works on the free key): it describes
# AI Catalog reference photos, checks customer previews and their "in your words" wishes, and
# translates announcements. gemini-2.5-flash is retired for new keys.
GEMINI_TEXT_MODEL="gemini-3.8-flash"
AI_IMAGE_MODEL="gemini-3.1-flash-image"
# Generations per designer per day (India time), and images per generation.
AI_DAILY_LIMIT="20"
AI_IMAGES_PER_GENERATION="4"

# ---------- Error monitoring (optional) ----------
SENTRY_DSN=""

# ---------- AI assistant (Step 15): services/ai, run with `pnpm ai:dev` ----------
# Leave AI_SERVICE_URL empty to turn the AI assistant off. The API and the AI service
# both read this file, so the token matches automatically. Production: long random token.
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TOKEN="dev-only-shared-secret"
# Tag suggestions: clip (free, runs locally) or claude (later; needs ANTHROPIC_API_KEY).
AI_TAGGER="clip"
ANTHROPIC_API_KEY=""
# Visual similarity (0-1) for "Likely duplicate" / "Similar" warnings in review.
AI_DUPLICATE_THRESHOLD="0.96"
AI_SIMILAR_THRESHOLD="0.93"
# Extra hosts the AI service may download images from (the SUPABASE_URL host is always allowed).
AI_ALLOWED_IMAGE_HOSTS=""

# ---------- Ordering (docs/apps/web.md "Ordering coming soon") ----------
# Off: the website shows "Ordering coming soon" (no bag, checkout or HD downloads); AI previews
# and try-ons still work, and customers can join the ordering waitlist. Set to true to open orders.
ORDERING_ENABLED=false
