{
  "name": "@abaya/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared tsconfig presets, ESLint flat config and Tailwind preset",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nestjs.json": "./tsconfig/nestjs.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./tsconfig/react-native.json": "./tsconfig/react-native.json",
    "./eslint": "./eslint/index.mjs",
    "./tailwind": "./tailwind/preset.cjs",
