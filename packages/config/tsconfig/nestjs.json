{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Abaya NestJS API",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "types": [
      "node"
    ],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": false,
    "declaration": false,
    "incremental": true
  }
}
